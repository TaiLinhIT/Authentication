<Window x:Class="LicenseClientSample.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_SoftwareActivation}" Width="650" Height="800" MinHeight="640"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,20">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="W" FontSize="16" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,1,0,0">
                        <TextBlock Text="{DynamicResource S_SoftwareActivation}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProductLine" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{DynamicResource S_LanguageToggle}" ToolTip="{DynamicResource S_LanguageToggleTip}"
                            Style="{StaticResource GhostButton}" Height="26" Width="40" FontSize="11"
                            Click="Language_Click"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="10.5"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,28,34,24">
                <Border Width="58" Height="58" CornerRadius="16" Background="{StaticResource AccentSoftBrush}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="{StaticResource AccentHoverBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TitleText" Text="{DynamicResource S_ActivateYourSoftware}" FontSize="25" FontWeight="SemiBold"
                           Margin="0,18,0,0"/>
                <TextBlock x:Name="IntroText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                           LineHeight="19"/>

                <Border x:Name="ReasonBorder" Style="{StaticResource SubtleCard}" Margin="0,18,0,0" Padding="14,12"
                        Background="{StaticResource WarningSoftBrush}" BorderBrush="#3A2E15" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <TextBlock x:Name="ReasonText" Foreground="{StaticResource WarningBrush}" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="18" MaxWidth="500"/>
                    </StackPanel>
                </Border>

                <Border x:Name="KeyWarningBorder" Style="{StaticResource SubtleCard}" Margin="0,18,0,0" Padding="14,12"
                        Background="{StaticResource DangerSoftBrush}" BorderBrush="#3A1C27" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA39;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <TextBlock x:Name="KeyWarningText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="18" MaxWidth="500"/>
                    </StackPanel>
                </Border>

                <!-- machine identity -->
                <TextBlock Text="{DynamicResource S_ThisMachineU}" Style="{StaticResource FieldLabel}" Margin="0,22,0,7"/>
                <Border Style="{StaticResource Card}" Padding="16" Background="{StaticResource CardAltBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource S_BindingDeviceId}" Style="{StaticResource Muted}" FontSize="11.5"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="DeviceIdText" Grid.Column="1" FontFamily="{StaticResource MonoFont}"
                                       FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Content="{DynamicResource S_Copy}" Style="{StaticResource GhostButton}" Height="28"
                                    FontSize="11" Click="CopyDeviceId_Click"/>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource S_BindingFingerprint}" Style="{StaticResource Muted}" FontSize="11.5"
                                       VerticalAlignment="Top" Margin="0,3,0,0"/>
                            <TextBlock x:Name="FingerprintText" Grid.Column="1" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" LineHeight="15" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="{DynamicResource S_Copy}" Style="{StaticResource GhostButton}" Height="28"
                                    FontSize="11" VerticalAlignment="Top" Click="CopyFingerprint_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="0,7,0,0"
                           Text="{DynamicResource S_SendDeviceHint}"/>

                <!-- key input -->
                <TextBlock Text="{DynamicResource S_LicenseKeyU}" Style="{StaticResource FieldLabel}" Margin="0,22,0,7"/>
                <Grid MinHeight="46">
                    <PasswordBox x:Name="KeyPassword" Style="{StaticResource InputPasswordBox}" Height="46"/>
                    <TextBox x:Name="KeyPlain" Style="{StaticResource CodeTextBox}" Height="96" Visibility="Collapsed"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{DynamicResource S_Paste}" Style="{StaticResource SecondaryButton}" Height="32" Width="86"
                            FontSize="11.5" Click="Paste_Click"/>
                    <Button Content="{DynamicResource S_ImportFile}" Style="{StaticResource SecondaryButton}" Height="32" Width="110"
                            FontSize="11.5" Margin="8,0,0,0" Click="ImportFile_Click"/>
                    <Button x:Name="ShowKeyButton" Content="{DynamicResource S_ShowKey}" Style="{StaticResource GhostButton}" Height="32"
                            FontSize="11.5" Margin="4,0,0,0" Click="ToggleKeyVisibility_Click"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center"
                               Margin="10,0,0,0" Text="{DynamicResource S_OrDropFile}"/>
                </StackPanel>

                <Border x:Name="ErrorBorder" Style="{StaticResource SubtleCard}" Margin="0,16,0,0" Padding="14,12"
                        Background="{StaticResource DangerSoftBrush}" BorderBrush="#3A1C27" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                               TextWrapping="Wrap" LineHeight="18"/>
                </Border>

                <Button x:Name="ActivateButton" Content="{DynamicResource S_Activate}" Style="{StaticResource PrimaryButton}" Height="46"
                        Margin="0,20,0,0" IsDefault="True" Click="Activate_Click"/>

                <TextBlock Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,12,0,0" LineHeight="16"
                           Text="{DynamicResource S_KeyVerifiedHint}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,14">
            <Grid>
                <TextBlock x:Name="VendorText" Style="{StaticResource Muted}" FontSize="10.5"
                           VerticalAlignment="Center"/>
                <Button Content="{DynamicResource S_Exit}" Style="{StaticResource GhostButton}" Height="30" Width="70"
                        HorizontalAlignment="Right" Click="Exit_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
