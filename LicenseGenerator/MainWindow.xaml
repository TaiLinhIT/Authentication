<Window x:Class="LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LicenseGenerator.ViewModels"
        xmlns:views="clr-namespace:LicenseGenerator.Views"
        Title="{DynamicResource S_AppTitle}" Width="1320" Height="860" MinWidth="1120" MinHeight="720"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicensesViewModel}">
            <views:LicensesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ sidebar ============================ -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="20,24,18,28">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="W" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,1,0,0">
                        <TextBlock Text="Warehouse" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="LICENSE STUDIO" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1" Style="{StaticResource NavList}"
                         ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         Margin="14,0"/>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource Card}" Margin="14,0,14,12" Padding="14">
                        <StackPanel>
                            <ContentControl Style="{StaticResource StatusPill}"
                                            Content="{Binding KeyStatusShort}" Tag="{Binding KeyStateKind}"/>
                            <TextBlock Text="{Binding KeyStatusHint}" Style="{StaticResource Muted}" FontSize="11"
                                       Margin="0,8,0,0"/>
                            <Button Content="{DynamicResource S_UnlockSigningKey}" Style="{StaticResource SecondaryButton}" Height="32"
                                    FontSize="11.5" Margin="0,12,0,0" Command="{Binding UnlockCommand}"
                                    Visibility="{Binding IsUnlocked, Converter={StaticResource InverseBoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource S_OfflineIssuance}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               Margin="20,0,0,18"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ workspace ============================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="32,26,32,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Display}" FontSize="24"/>
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource S_LanguageToggle}" ToolTip="{DynamicResource S_LanguageToggleTip}"
                            Style="{StaticResource GhostButton}" Height="36" Width="44" Margin="0,0,10,0"
                            FontSize="11.5" Click="Language_Click"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding IssueLicenseCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S_IssueLicense}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Command="{Binding AddProductCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S_AddProduct}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource DangerSoftBrush}" BorderBrush="#3A1C27"
                    BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="32,0,32,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorBanner}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="32,0,32,26"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
