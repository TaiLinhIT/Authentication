<Window x:Class="LicenseGenerator.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_Confirm}" Width="480" SizeToContent="Height"
        Style="{StaticResource DialogWindow}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26,22,26,24">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="IconBadge" Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Width="38" Height="38">
                <TextBlock x:Name="IconGlyph" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{StaticResource AccentHoverBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="DialogTitle" Style="{StaticResource DialogTitle}" VerticalAlignment="Center"
                       Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="350"/>
        </StackPanel>

        <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"
                   Margin="0,18,0,0" LineHeight="20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{DynamicResource S_Cancel}" Style="{StaticResource SecondaryButton}" Width="104" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="{DynamicResource S_Confirm}" Style="{StaticResource PrimaryButton}" Width="136"
                    Margin="10,0,0,0" IsDefault="True" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
