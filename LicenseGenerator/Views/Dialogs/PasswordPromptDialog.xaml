<Window x:Class="LicenseGenerator.Views.Dialogs.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_UnlockSigningKey}" Width="460" SizeToContent="Height"
        Style="{StaticResource DialogWindow}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26,22,26,24">
        <TextBlock Text="{DynamicResource S_UnlockSigningKey}" Style="{StaticResource DialogTitle}"/>
        <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20"/>

        <TextBlock Text="{DynamicResource S_IssuerPasswordU}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="PasswordInput" Style="{StaticResource InputPasswordBox}" Height="42"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>



        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="{DynamicResource S_Cancel}" Style="{StaticResource SecondaryButton}" Width="100" IsCancel="True"/>
            <Button Content="{DynamicResource S_Unlock}" Style="{StaticResource PrimaryButton}" Width="120" Margin="10,0,0,0"
                    IsDefault="True" Click="Unlock_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
