<UserControl x:Class="LicenseGenerator.Views.LicensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Width="300" HorizontalAlignment="Left">
                <TextBox Style="{StaticResource InputTextBox}" Padding="36,0,12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                           Margin="13,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"/>
                <TextBlock Text="{DynamicResource S_SearchSerial}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}"/>
            </Grid>

            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="150" Height="40"
                      Margin="10,0,0,0" ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Label"
                      SelectedItem="{Binding StatusFilter}"/>

            <TextBlock Grid.Column="3" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>

            <Button Grid.Column="4" Content="{DynamicResource S_ExportCsv}" Style="{StaticResource SecondaryButton}" Height="36"
                    Command="{Binding ExportCsvCommand}"/>
        </Grid>

        <!-- header -->
        <Grid Grid.Row="1" Margin="18,0,18,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="146"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{DynamicResource S_LicenseU}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource S_CustomerStationU}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource S_DeviceU}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource S_TypeU}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="4" Text="{DynamicResource S_ExpiresU}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="5" Text="{DynamicResource S_StatusU}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </Grid>

        <!-- list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="0.85*"/>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="146"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding LicenseId}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProductName}" Style="{StaticResource Muted}"
                                                   FontSize="10.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding CustomerName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StationName}" Style="{StaticResource Muted}"
                                                   FontSize="10.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DeviceShort}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DeviceId}"/>
                                        <TextBlock Text="{Binding BindingLabel}" Style="{StaticResource Muted}"
                                                   FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="11.5" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding IssuedLabel}" Style="{StaticResource Muted}"
                                                   FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" Text="{Binding ExpiresLabel}" FontSize="11.5"
                                               VerticalAlignment="Center"/>

                                    <ContentControl Grid.Column="5" Style="{StaticResource StatusPill}"
                                                    Content="{Binding StateLabel}" Tag="{Binding StatusKind}"
                                                    VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="{DynamicResource S_Copy}" Style="{StaticResource GhostButton}" Height="30"
                                                FontSize="11.5" Width="48" ToolTip="{DynamicResource S_CopyActivationCode}"
                                                Command="{Binding CopyCodeCommand}"/>
                                        <Button Style="{StaticResource GhostButton}" Width="32" Margin="2,0,0,0"
                                                ToolTip="{DynamicResource S_SaveLicenseFile}" Command="{Binding SaveFileCommand}">
                                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Width="32" Margin="2,0,0,0"
                                                ToolTip="{DynamicResource S_MoreActions}">
                                            <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{DynamicResource S_InspectLicense}" Command="{Binding InspectCommand}"/>
                                                    <MenuItem Header="{DynamicResource S_SaveLicenseFile}" Command="{Binding SaveFileCommand}"/>
                                                    <MenuItem Header="{DynamicResource S_SaveOfficeDat}" Command="{Binding SaveOfficeFileCommand}"/>
                                                    <MenuItem Header="{DynamicResource S_RenewLicense}" Command="{Binding RenewCommand}"/>
                                                    <MenuItem Header="{DynamicResource S_RevokeRestore}" Command="{Binding RevokeCommand}"/>
                                                    <MenuItem Header="{DynamicResource S_RemoveFromRegister}" Command="{Binding DeleteCommand}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Padding="44" Margin="0,4,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoftBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource S_NoLicensesHere}" Style="{StaticResource H2}" FontSize="16"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="420" Margin="0,7,0,0"
                                   Text="{DynamicResource S_NoLicensesHereHint}"/>
                        <Button Content="{DynamicResource S_IssueALicense}" Style="{StaticResource PrimaryButton}" Width="170"
                                Margin="0,18,0,0" Command="{Binding IssueCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
