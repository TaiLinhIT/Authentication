<UserControl x:Class="LicenseGenerator.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Width="330" HorizontalAlignment="Left">
                <TextBox Style="{StaticResource InputTextBox}" Padding="36,0,12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                           Margin="13,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"/>
                <TextBlock Text="{DynamicResource S_SearchProducts}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="36,0,0,0" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}"/>
            </Grid>

            <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- header -->
        <Grid Grid.Row="1" Margin="18,0,18,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1" Text="{DynamicResource S_ProductU}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource S_AlgorithmU}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource S_KeygenModeU}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="4" Text="{DynamicResource S_IssuedU}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </Grid>

        <!-- list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="1.05*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="250"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="34" Height="34" CornerRadius="9"
                                            Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentHoverBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProductId}" Style="{StaticResource Mono}"
                                                   FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AlgorithmLabel}" FontSize="12"/>
                                        <TextBlock Text="{Binding KeyIdShort}" Style="{StaticResource Mono}"
                                                   FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <ContentControl Grid.Column="3" Style="{StaticResource StatusPill}"
                                                    Content="{Binding KeygenModeLabel}" Tag="{Binding KeygenKind}"
                                                    VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4" Text="{Binding LicenseCountText}" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" FontSize="12"/>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="{DynamicResource S_Issue}" Style="{StaticResource SecondaryButton}" Width="72"
                                                Height="30" FontSize="11.5" Command="{Binding IssueCommand}"/>
                                        <Button Style="{StaticResource GhostButton}" Width="32"
                                                Margin="6,0,0,0" ToolTip="{DynamicResource S_EditProduct}" Command="{Binding EditCommand}">
                                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Width="32"
                                                Margin="2,0,0,0" ToolTip="{DynamicResource S_ExportPublicKey}"
                                                Command="{Binding ExportPublicKeyCommand}">
                                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button Style="{StaticResource DangerGhostButton}" Width="32"
                                                Margin="2,0,0,0" ToolTip="{DynamicResource S_DeleteProduct}" Command="{Binding DeleteCommand}">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Padding="44" Margin="0,4,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoftBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource S_NoProductsYet}" Style="{StaticResource H2}" FontSize="16"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="380" Margin="0,7,0,0"
                                   Text="{DynamicResource S_NoProductsHint}"/>
                        <Button Content="{DynamicResource S_CreateFirstProduct}" Style="{StaticResource PrimaryButton}"
                                Width="200" Margin="0,18,0,0" Command="{Binding AddCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
